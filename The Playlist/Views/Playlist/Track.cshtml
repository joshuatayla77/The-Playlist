@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <h1>@ViewData["Tunes"]</h1>
}

@if (ViewBag.Number - 1 > 0)
{
    <a asp-controller="Playlist" asp-action="Track" asp-route-number="@(ViewBag.Number - 1)">Previous</a>

}
@if (ViewBag.Number + 1 < 6)
{
    <a asp-controller="Playlist" asp-action="Track" asp-route-number="@(ViewBag.Number + 1)">Next</a>
}
